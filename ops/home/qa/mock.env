# Public, inert credentials for the local mock provider only.
# Never point a non-mock Compose stack at this file.
OPENCODE_GO_API_KEY=mock-opencode-key
LITELLM_MASTER_KEY=sk-litellm-mock-only
OPENCODE_GO_API_BASE=http://mock-opencode:4100/v1
CFOS_HOST_PORT=8877
LITELLM_HOST_PORT=4001
PUBLIC_BASE_URL=http://127.0.0.1:8877
CFOS_IMAGE=cloudflare-os-home:local
CFOS_WRANGLER_VOLUME=cloudflare-os-home-wrangler
CFOS_PNPM_VOLUME=cloudflare-os-home-pnpm-store
