# Copy to ops/home/.env, replace both dummy secrets, then chmod 600 ops/home/.env.
# Never commit the resulting file.
OPENCODE_GO_API_KEY=opencode-go-replace-me
LITELLM_MASTER_KEY=sk-litellm-replace-me

# Verified against the OpenCode Go documentation on 2026-08-08.
OPENCODE_GO_API_BASE=https://opencode.ai/zen/go/v1

CFOS_HOST_PORT=8877
LITELLM_HOST_PORT=4001
PUBLIC_BASE_URL=http://127.0.0.1:8877
CFOS_IMAGE=cloudflare-os-home:local
CFOS_WRANGLER_VOLUME=cloudflare-os-home-wrangler
CFOS_PNPM_VOLUME=cloudflare-os-home-pnpm-store
